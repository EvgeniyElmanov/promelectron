# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promelectron

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=promelectron-uploads
MINIO_SECURE=false

# SMTP (optional — email notifications fall back gracefully if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@promelectron.ru
SMTP_TLS=true

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ENABLED=true
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# YooKassa (test credentials for CI/E2E)
YOOKASSA_SHOP_ID=54401
YOOKASSA_SECRET_KEY=test_Fh8hUAVVBGUGbjmlzba6TB0iyUbos_lueTHE-axOwM0
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_TEST_MODE=true
