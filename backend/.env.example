# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promelectron

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seed endpoint (POST /api/v1/seed): dev/test only. В production НЕ задавать —
# без SEED_SECRET endpoint всегда отвечает 403 (prod-guard, F006/S001).
SEED_SECRET=promelectron-test-seed-2024

# Environment
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=promelectron-uploads
MINIO_INTAKE_BUCKET=onec-intake
MINIO_SECURE=false

# Cache-Control max-age (секунды) для отдачи файлов из /uploads/
UPLOADS_CACHE_MAX_AGE=86400

# SMTP (optional — email notifications fall back gracefully if not set)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=your-smtp-user@yandex.ru
SMTP_FROM_NAME=MyShop
SMTP_USE_TLS=true
SMTP_STARTTLS=false
# Deprecated: SMTP_TLS is an alias for SMTP_STARTTLS
SMTP_TLS=false

# Email verification
VERIFY_BASE_URL=http://localhost:5173
EMAIL_VERIFY_TOKEN_TTL_MINUTES=60

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ENABLED=true
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# YooKassa (test credentials for CI/E2E)
YOOKASSA_SHOP_ID=54401
YOOKASSA_SECRET_KEY=test_Fh8hUAVVBGUGbjmlzba6TB0iyUbos_lueTHE-axOwM0
# Обязателен в production: без него backend не стартует (fail-fast, #210).
# Вне production может быть пустым, но тогда вебхук /payments/yookassa/webhook/ всегда отвечает 403.
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_TEST_MODE=true

# CDEK (Delivery)
CDEK_ACCOUNT=wqGwiQx0gg8mLtiEKsUinjVSICCjtTEP
CDEK_SECURE=RmAmgvSgSl1yirlz9QupbzOJVqhCxcP5
CDEK_API_URL=https://api.edu.cdek.ru
CDEK_TEST_MODE=true
CDEK_SYNC_CRON_INTERVAL_SECONDS=900
CDEK_TERMINAL_STATUSES=DELIVERED,NOT_DELIVERED,RETURNED,CANCELLED,INVALID

# Job Worker
JOB_WORKER_SLEEP_SECONDS=60
JOB_MAX_ATTEMPTS=5

# 1C:УНФ webhook
ONEC_WEBHOOK_API_KEY=

# 1C:УНФ OData (pull fallback)
ONEC_API_URL=
ONEC_LOGIN=
ONEC_PASSWORD=
ONEC_SITE_PRICE_TYPE=site
ONEC_WAREHOUSE_KEY=
ONEC_DEFAULT_SUPPLIER_ID=

# Meilisearch (каталожный поиск, фаза 5 #121)
# Включение поиска — Redis feature flag `catalog_search_meilisearch` (D-09), env-флага нет.
# TODO: сгенерировать сильный ключ — openssl rand -hex 32
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=dev-meili-master-key-change-in-prod
SEARCH_REINDEX_TIMEOUT_SECONDS=3600
