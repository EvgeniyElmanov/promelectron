# ============================================================
# My Shop Backend — Environment Variables
# ============================================================
# 1. Скопируй этот файл: cp .env.example .env
# 2. Заполни значения
# 3. Не коммить .env в git!
# ============================================================

# --- Security ---
SECRET_KEY=change-me-to-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database ---
DATABASE_URL=postgresql+asyncpg://shop_user:shop_password@localhost/shop_db

# --- OAuth 2.0 (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth 2.0 (Yandex) ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
