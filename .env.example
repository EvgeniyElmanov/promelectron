# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promelectron

# --- Auth ---
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Seed endpoint (dev/test only) ---
# В production НЕ задавать: без SEED_SECRET POST /api/v1/seed всегда 403 (F006/S001).
SEED_SECRET=promelectron-test-seed-2024

# --- OAuth (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ENABLED=true

# --- OAuth (Yandex) ---
# Callback URI для Яндекс OAuth: {FRONTEND_URL}/auth/callback
# Пример: http://localhost:5173/auth/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Frontend / API URLs ---
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# --- Email (SMTP) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=your-smtp-user@yandex.ru
SMTP_FROM_NAME=MyShop
SMTP_USE_TLS=true
SMTP_STARTTLS=false
# Deprecated: SMTP_TLS is an alias for SMTP_STARTTLS
SMTP_TLS=false

# --- Email verification ---
VERIFY_BASE_URL=http://localhost:5173
EMAIL_VERIFY_TOKEN_TTL_MINUTES=60

# --- MinIO / S3 ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=promelectron-uploads
MINIO_SECURE=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Environment ---
ENVIRONMENT=development

# --- 1C ERP Integration ---
ONEC_WEBHOOK_API_KEY=
ONEC_API_URL=
ONEC_LOGIN=
ONEC_PASSWORD=
ONEC_PRICE_TYPE_KEY=
ONEC_WAREHOUSE_KEY=

# --- 1C Mock Server (mocks/onec-server, Фаза 7) ---
ONEC_WEBHOOK_API_KEY=
ONEC_MOCK_SYNC_INTERVAL_MINUTES=30
ONEC_MOCK_SEED_ON_START=true
ONEC_MOCK_SEED_PRODUCTS_COUNT=200
ONEC_MOCK_CATALOG_SEED=42

# --- YooKassa (Payments) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_TEST_MODE=true
YOOKASSA_CAPTURE_AUTO=true
YOOKASSA_VAT_CODE=1
YOOKASSA_TAX_SYSTEM_CODE=1
YOOKASSA_RECEIPT_ENABLED=false

# --- CDEK Widget ---
# Yandex Maps JS API key — required by the official CDEK widget v3 to render the map.
# This is NOT a CDEK account/key; CDEK API credentials are configured on the backend.
VITE_YANDEX_MAPS_API_KEY=

# --- CDEK (Delivery) ---
# Public test credentials from https://apidoc.cdek.ru/
CDEK_ACCOUNT=wqGwiQx0gg8mLtiEKsUinjVSICCjtTEP
CDEK_SECURE=RmAmgvSgSl1yirlz9QupbzOJVqhCxcP5
CDEK_API_URL=https://api.edu.cdek.ru
CDEK_TEST_MODE=true
CDEK_SYNC_CRON_INTERVAL_SECONDS=900
CDEK_TERMINAL_STATUSES=DELIVERED,NOT_DELIVERED,RETURNED,CANCELLED

# --- Job Worker ---
JOB_WORKER_SLEEP_SECONDS=60
JOB_MAX_ATTEMPTS=5

# --- Meilisearch (catalog search, phase 5 #121) ---
# Включение поиска — Redis feature flag `catalog_search_meilisearch` (D-09), env-флага нет.
# TODO: сгенерировать сильный ключ — openssl rand -hex 32
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=dev-meili-master-key-change-in-prod
SEARCH_REINDEX_TIMEOUT_SECONDS=3600
