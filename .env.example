# ============================================================
# My Shop Backend — Environment Variables
# ============================================================
# 1. Скопируй этот файл: cp .env.example .env
# 2. Заполни значения
# 3. Не коммить .env в git!
# ============================================================

# --- Security ---
SECRET_KEY=change-me-to-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database ---
DATABASE_URL=postgresql+asyncpg://shop_user:shop_password@localhost/shop_db

# --- OAuth 2.0 (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth 2.0 (Yandex) ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@myshop.ru
SMTP_TLS=true

# --- Base URL ---
API_BASE_URL=http://localhost:8000

# --- MinIO (S3-compatible storage) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=promelectron-uploads
MINIO_SECURE=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Environment ---
ENVIRONMENT=development
