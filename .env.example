# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promelectron

# --- Auth ---
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OAuth (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ENABLED=true

# --- OAuth (Yandex) ---
# Callback URI для Яндекс OAuth: {FRONTEND_URL}/auth/callback
# Пример: http://localhost:5173/auth/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Frontend / API URLs ---
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
VITE_YANDEX_MAPS_API_KEY=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@myshop.ru
SMTP_TLS=true

# --- MinIO / S3 ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=promelectron-uploads
MINIO_SECURE=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Environment ---
ENVIRONMENT=development

# --- 1C ERP Integration ---
ONEC_API_URL=
ONEC_API_KEY=

# --- YooKassa (Payments) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_TEST_MODE=true
YOOKASSA_CAPTURE_AUTO=true
YOOKASSA_VAT_CODE=1
YOOKASSA_TAX_SYSTEM_CODE=1
YOOKASSA_RECEIPT_ENABLED=false

# --- CDEK (Delivery) ---
CDEK_ACCOUNT=
CDEK_SECURE=
CDEK_API_URL=https://api.edu.cdek.ru
CDEK_TEST_MODE=true
