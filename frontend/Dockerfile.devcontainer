FROM node:24-slim

# Install system dependencies required by Playwright Chromium
# (node:24-slim is glibc-based but lacks the X11/graphics libs headless Chrome needs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
    libpango-1.0-0 libcairo2 libasound2 libatspi2.0-0 libexpat1 libdbus-1-3 \
    libx11-6 libxext6 libxcb1 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install browsers for Playwright (Chromium is enough for tests)
RUN npx playwright install chromium

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
