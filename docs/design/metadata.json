  "component_library": {
    "buttons": {
      "variants": ["primary", "secondary", "secondary_on_dark"],
      "states": ["default", "hover", "pressed", "disabled"]
    },
    "product_card": {
      "variants": ["default", "hover", "sale", "new", "out_of_stock", "added_to_cart", "favorite"],
      "required_parts": ["image", "badge", "title", "price", "availability", "favorite", "compare", "add_to_cart"]
    },
    "category_card": {
      "required_parts": ["image", "title"],
      "interactive": true
    },
    "search": {
      "states": ["default", "focus", "filled", "results"]
    },
    "header_action": {
      "supports_badge": true
    },
    "tabs": {
      "states": ["default", "active", "hover"]
    }
  },

  "interactions": {
    "primary_routes": [
      "search -> product -> cart",
      "category -> filters -> product",
      "task/business_need -> products or consultation"
    ],
    "header": [
      "catalog opens product catalog",
      "search opens/searches product results",
      "compare opens comparison list",
      "favorites opens favorites",
      "account opens authentication/account",
      "cart opens cart"
    ],
    "hero": [
      "primary CTA -> catalog",
      "secondary CTA -> new products",
      "carousel arrows change slide",
      "pagination changes active slide"
    ],
    "products": [
      "product card -> product page",
      "favorite -> add/remove favorite",
      "compare -> add/remove comparison",
      "add_to_cart -> add product to cart"
    ]
  },

  "responsive": {
    "mobile_target": {
      "reference_width": 375,
      "horizontal_padding": 16,
      "columns": 4,
      "gutter": 12
    },
    "rules": [
      "Desktop header collapses into mobile header.",
      "Horizontal category navigation becomes horizontally scrollable or collapsible.",
      "Hero content stacks vertically and preserves primary CTA visibility.",
      "Category cards become a horizontal scroll/list or 2-column grid depending on implementation.",
      "Product cards adapt to 2-column mobile grid.",
      "Benefits become a horizontal scroll or stacked list.",
      "Consultation CTA remains visible near the end of the homepage."
    ]
  },

