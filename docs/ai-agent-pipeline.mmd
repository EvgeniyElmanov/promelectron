%%{init: {'flowchart': {'curve': 'basis', 'padding': 16}}}%%
flowchart TD
    subgraph Entry ["Entry skills"]
        IMP(["/skill:implement"])
        FIX(["/skill:fix"])
        SPEC(["/skill:spec"])
        REV(["/skill:review"])
        QA(["/skill:qa-gate"])
        SHIP(["/skill:ship"])
    end

    IMP --> Prep
    FIX --> Prep
    SPEC --> Plan
    REV --> Review
    QA --> Test
    SHIP --> PR

    Prep["Prepare workspace<br/>.agent/runs/{id}<br/>.worktrees/{id}"] --> Plan

    Plan["Architect writes spec.md"] --> Approve
    Approve["Human approval"] -->|clarify| Plan
    Approve --> Dev

    Dev["Developer implements<br/>status: In progress"] --> Review
    Review["Code reviewer<br/>≤3 iterations"] -->|needs work| Dev
    Review --> Test

    Test["QA gate<br/>pytest · vitest · E2E"] --> PR
    PR["Pull Request<br/>status: In review"] --> Merge
    Merge["Human merge"] --> Done(["Done"])

    classDef entry fill:#e1f5ff,stroke:#01579b,stroke-width:2px
    classDef coord fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef human fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef agent fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    classDef final fill:#ffebee,stroke:#c62828,stroke-width:2px

    class IMP,FIX,SPEC,REV,QA,SHIP entry
    class Prep coord
    class Approve,Merge human
    class Plan,Dev,Review,Test,PR agent
    class Done final
