{
  "name": "my-shop-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "agent": "node tests/agent/agent.js",
    "agent:user": "node tests/agent/agent.js --persona=user --report=all",
    "agent:admin": "node tests/agent/agent.js --persona=admin --report=all",
    "agent:supplier": "node tests/agent/agent.js --persona=supplier --report=all",
    "agent:security": "node tests/agent/agent.js --persona=security --report=all",
    "agent:performance": "node tests/agent/agent.js --performance --report=all",
    "agent:accessibility": "node tests/agent/agent.js --accessibility --report=all",
    "agent:responsive": "node tests/agent/agent.js --responsive --report=all",
    "agent:crossrole": "node tests/agent/agent.js --persona=crossrole --report=all",
    "agent:fuzz": "node tests/agent/agent.js --persona=fuzz --report=all",
    "agent:all": "node tests/agent/agent.js --persona=all --report=all",
    "agent:discover": "node tests/agent/agent.js --persona=user --discover --report=all"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^2026.1.14",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@modelcontextprotocol/server-memory": "^2026.1.26",
    "@modelcontextprotocol/server-sequential-thinking": "^2025.12.18",
    "@playwright/mcp": "^0.0.75",
    "@playwright/test": "^1.60.0",
    "jsdom": "^29.1.1",
    "openai": "^4.0.0"
  }
}
