{
  "permissions": {
    "Bash": {
      ".*uvicorn.*": "allow",
      ".*pytest.*": "allow",
      ".*vitest.*": "allow",
      ".*npm (run |install |test ).*": "allow",
      ".*npx .*": "allow",
      ".*pip install.*": "allow",
      ".*playwright.*": "allow",
      ".*docker-compose.*": "allow",
      ".*docker compose.*": "allow",
      ".*source venv.*": "allow",
      ".*mkdir.*": "allow",
      ".*ls.*": "allow",
      ".*rm.*": "allow",
      ".*git (status|diff|log|add|commit|branch|checkout).*": "allow",
      ".*cd client && npm.*": "allow",
      ".*cd client/ && npm.*": "allow",
      ".*bash scripts/run_dev.sh.*": "allow",
      ".*bash scripts/stop_dev.sh.*": "allow",
      ".*bash scripts/run_e2e.sh.*": "allow",
      ".*lsof.*": "allow",
      ".*kill.*": "allow",
      ".*curl.*": "allow",
      ".*tail.*": "allow",
      ".*pkill.*": "allow"
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "(Edit|Write)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'AUTO-TEST REMINDER: Если ты добавил новый функционал, создай соответствующие тесты! Бэкенд: tests/test_*.py, Фронтенд: client/src/__tests__/*.spec.js, E2E: Playwright MCP. Запуск тестов: pytest tests/ -v && cd client && npx vitest run'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "(Edit|Write)",
        "fileMatcher": "server/.*\\.py$",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BACKEND TEST HOOK: Python файл изменён. Не забудь запустить pytest tests/ -v и добавить тест в tests/test_<module>.py если это новый функционал!'",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "(Edit|Write)",
        "fileMatcher": "client/.*\\.(vue|js|ts)$",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'FRONTEND TEST HOOK: Vue/JS файл изменён. Не забудь запустить cd client && npx vitest run и добавить тест в client/src/__tests__/<Component>.spec.js если это новый компонент!'",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
